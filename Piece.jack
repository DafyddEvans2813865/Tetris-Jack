class Piece{
    field int type, rotation, x, y;
    field Array cells;
    field int originX, originY, GRID_SIZE;
    static Array shapes;

    constructor Piece new(int pieceType, int startX, int startY, int boardOriginX, int boardOriginY, int cellSize) {
        var int i;
        var Array cell;
        let type = pieceType;
        let rotation = 0;
        let x = startX;
        let y = startY;
        let originX = boardOriginX;
        let originY = boardOriginY;
        let GRID_SIZE = cellSize;
        let cells = Array.new(4);
        let i = 0;
        while (i < 4) {
            let cell = Array.new(2);
            let cells[i] = cell;
            let i = i + 1;
        }
        return this;
    }

    method void draw() {
        var int i, row, col, screenX, screenY;
        var Array pieceCells, cell;
        let pieceCells = getCells();
        let i = 0;
        while (i < 4) {
            let cell = pieceCells[i];
            let row = cell[0];
            let col = cell[1];
            let screenX = originX + (col * GRID_SIZE);
            let screenY = originY + (row * GRID_SIZE);
            do Screen.setColor(true);
            do Screen.drawRectangle(screenX, screenY, screenX + GRID_SIZE - 1, screenY + GRID_SIZE - 1);
            let i = i + 1;
        }
        return;
    }

    function Array makeShape(int r0, int c0, int r1, int c1, int r2, int c2, int r3, int c3){
        var Array shape, cell;
        let shape = Array.new(4);
        let cell = Array.new(2); let cell[0] = r0; let cell[1] = c0; let shape[0] = cell;
        let cell = Array.new(2); let cell[0] = r1; let cell[1] = c1; let shape[1] = cell;
        let cell = Array.new(2); let cell[0] = r2; let cell[1] = c2; let shape[2] = cell;
        let cell = Array.new(2); let cell[0] = r3; let cell[1] = c3; let shape[3] = cell;
        return shape;
    }

    function void init(){
        var Array typeShapes;
        let shapes = Array.new(7);

        //I (type 0)
        let typeShapes = Array.new(4);
        let typeShapes[0] = Piece.makeShape(1,0, 1,1, 1,2, 1,3);
        let typeShapes[1] = Piece.makeShape(0,2, 1,2, 2,2, 3,2);
        let typeShapes[2] = Piece.makeShape(2,0, 2,1, 2,2, 2,3);
        let typeShapes[3] = Piece.makeShape(0,1, 1,1, 2,1, 3,1);
        let shapes[0] = typeShapes;

        // O (type 1)
        let typeShapes = Array.new(4);
        let typeShapes[0] = Piece.makeShape(0,1, 0,2, 1,1, 1,2);
        let typeShapes[1] = typeShapes[0];
        let typeShapes[2] = typeShapes[0];
        let typeShapes[3] = typeShapes[0];
        let shapes[1] = typeShapes;

        // T (type 2)
        let typeShapes = Array.new(4);
        let typeShapes[0] = Piece.makeShape(0,1, 1,0, 1,1, 1,2);
        let typeShapes[1] = Piece.makeShape(0,1, 1,1, 1,2, 2,1);
        let typeShapes[2] = Piece.makeShape(1,0, 1,1, 1,2, 2,1);
        let typeShapes[3] = Piece.makeShape(0,1, 1,0, 1,1, 2,1);
        let shapes[2] = typeShapes;

        // S (type 3) — like O, this one only has 2 visually distinct
        // shapes, so rotations 2 and 3 just reuse 0 and 1
        let typeShapes = Array.new(4);
        let typeShapes[0] = Piece.makeShape(0,1, 0,2, 1,0, 1,1);
        let typeShapes[1] = Piece.makeShape(0,1, 1,1, 1,2, 2,2);
        let typeShapes[2] = typeShapes[0];
        let typeShapes[3] = typeShapes[1];
        let shapes[3] = typeShapes;

        // Z (type 4)
        let typeShapes = Array.new(4);
        let typeShapes[0] = Piece.makeShape(0,0, 0,1, 1,1, 1,2);
        let typeShapes[1] = Piece.makeShape(0,2, 1,1, 1,2, 2,1);
        let typeShapes[2] = typeShapes[0];
        let typeShapes[3] = typeShapes[1];
        let shapes[4] = typeShapes;

        // J (type 5)
        let typeShapes = Array.new(4);
        let typeShapes[0] = Piece.makeShape(0,0, 1,0, 1,1, 1,2);
        let typeShapes[1] = Piece.makeShape(0,1, 0,2, 1,1, 2,1);
        let typeShapes[2] = Piece.makeShape(1,0, 1,1, 1,2, 2,2);
        let typeShapes[3] = Piece.makeShape(0,1, 1,1, 2,0, 2,1);
        let shapes[5] = typeShapes;

        // L (type 6) — mirror of J
        let typeShapes = Array.new(4);
        let typeShapes[0] = Piece.makeShape(0,2, 1,0, 1,1, 1,2);
        let typeShapes[1] = Piece.makeShape(0,1, 1,1, 2,1, 2,2);
        let typeShapes[2] = Piece.makeShape(1,0, 1,1, 1,2, 2,0);
        let typeShapes[3] = Piece.makeShape(0,0, 0,1, 1,1, 2,1);
        let shapes[6] = typeShapes;

        return;
    }

    method Array getCells(){
        var Array rotationShapes, offset, cell, oneOffset;
        var int i;
        let rotationShapes = shapes[type];
        let offset = rotationShapes[rotation];
        let i = 0;
        while(i<4){
            let oneOffset = offset[i];
            let cell = cells[i];
            let cell[0] = oneOffset[0] + y; //row
            let cell[1] = oneOffset[1] + x; //col
            let i = i + 1;
        }
        return cells;
    }

    method boolean rotate(Board board) {
        var int oldRotation;
        let oldRotation = rotation;
        let rotation = (rotation + 1) & 3;

        if (board.canPlace(getCells())) {
            return true;
        }

        // rejected
        let rotation = oldRotation;
        return false;
    }

    method boolean moveDown(Board board) {
        let y = y + 1;
        if (board.canPlace(getCells())) {
            return true;
        }
        let y = y - 1;
        return false;
    }

    method boolean moveHorizontal(Board board, int dx) {
        let x = x + dx;
        if (board.canPlace(getCells())) {
            return true;
        }
        let x = x - dx;
        return false;
    }

    method void dispose() {
        var int i;
        var Array cell;
        let i = 0;

        while (i < 4) {
            let cell = cells[i];
            do cell.dispose();
            let i = i + 1;
        }
        do cells.dispose();
        do Memory.deAlloc(this);
        return;
    } 
}