class Random {
    static int seed;

    function void setSeed(int s) {
        let seed = s;
        return;
    }

    function int next() {
        let seed = (seed * 31421) + 6927;
        if (seed < 0) {
            let seed = -seed;   
        }
        return seed;
    }

    function int randomType() {
        var int r;
        let r = Random.next();
        return r - ((r / 7) * 7);
    }
}