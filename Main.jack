class Main {
    function void main() {
        var Game game;
        do Main.seedFromInput();
        let game = Game.new();
        do game.run();
        return;
    }

    function void seedFromInput() {
        var int counter;
        let counter = 0;
        while (Keyboard.keyPressed() = 0) {
            let counter = counter + 1;
            let counter = counter - ((counter / 32000) * 32000);
        }
        do Random.setSeed(counter);
        return;
    }
}